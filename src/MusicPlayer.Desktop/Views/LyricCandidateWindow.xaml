<Window x:Class="MusicPlayer.Desktop.Views.LyricCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择歌词" Height="340" Width="440" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Icon="/Assets/logo.ico">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="找到多组匹配的歌词，请选择一组：" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OK_Click"/>
      <Button Content="取消" Width="80" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel>
    <ListBox x:Name="List" ItemsSource="{Binding Candidates}" MouseDoubleClick="List_MouseDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,4">
            <TextBlock Text="{Binding TrackName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding ArtistName, StringFormat='— {0}'}" Foreground="#5F5E5A" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
