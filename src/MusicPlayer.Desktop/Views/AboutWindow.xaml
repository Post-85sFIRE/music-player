<Window x:Class="MusicPlayer.Desktop.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 音乐播放器" Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/Assets/logo.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24">
      <Image Source="/Assets/logo.png" Width="72" Height="72" Stretch="Uniform"/>
      <TextBlock Text="音乐播放器" FontSize="20" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,16,0,0"/>
      <TextBlock Text="由 85后财务自由之路 制作" FontSize="14" Foreground="#5F5E5A" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      <TextBlock Text="如果它对你有用，欢迎赞赏支持" FontSize="12" Foreground="#888" HorizontalAlignment="Center" Margin="0,18,0,8"/>
      <Image Source="/Assets/donate.png" Width="200" Height="200" Stretch="Uniform"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
        <Button Content="检查更新" Width="90" Margin="0,0,8,0" Click="CheckUpdate_Click"/>
        <Button Content="确定" Width="80" Click="OK_Click"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
