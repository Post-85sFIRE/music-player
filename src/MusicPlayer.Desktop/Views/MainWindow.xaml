<Window x:Class="MusicPlayer.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MusicPlayer.Desktop.ViewModels"
        xmlns:local="clr-namespace:MusicPlayer.Desktop.Converters"
        Title="音乐播放器" Height="720" Width="1120" Icon="/Assets/logo.ico" PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Window.Resources>
    <!-- 圆形控制按钮（上一首/下一首等） -->
    <Style x:Key="RoundButton" TargetType="Button">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="#3A3A38"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="24"
                    BorderThickness="0" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E7E3D8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#D6D1C2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主播放/暂停按钮：大圆形、强调色 -->
    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="Width" Value="64"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#4A8FE7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="32"
                    BorderThickness="0" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3A7BD0"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2F67B0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 圆角模式按钮（中文文案） -->
    <Style x:Key="ModeButton" TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#3A3A38"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="19"
                    BorderThickness="0" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E7E3D8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#D6D1C2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 播放列表序号 / 正在播放高亮 转换器 -->
    <local:IsCurrentItemConverter x:Key="IsCurrentItemConverter"/>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件">
        <MenuItem Header="设置" Click="OpenSettings_Click"/>
        <MenuItem Header="云盘" Click="OpenCloud_Click"/>
        <MenuItem Header="退出" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="关于" Click="About_Click"/>
    </Menu>

    <!-- 传输控制条 -->
    <Grid DockPanel.Dock="Bottom" Height="96" Background="#F1EFE8">
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="40"/>
      </Grid.RowDefinitions>

      <!-- 第一行：主控制 + 模式 -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Style="{StaticResource RoundButton}" Content="⏮" ToolTip="上一首" Command="{Binding Playback.PreviousCommand}"/>
        <Button Style="{StaticResource PlayButton}" Content="{Binding Playback.PlayPauseLabel}"
                Margin="16,0" Command="{Binding Playback.PlayPauseCommand}"/>
        <Button Style="{StaticResource RoundButton}" Content="⏭" ToolTip="下一首" Command="{Binding Playback.NextCommand}"/>
        <Button Style="{StaticResource ModeButton}" Content="{Binding Playback.ModeLabel}"
                Margin="18,0,0,0" ToolTip="播放模式" Command="{Binding Playback.CycleModeCommand}"/>
        <Button Style="{StaticResource ModeButton}" Content="{Binding Settings.ReplayGainLabel}"
                Margin="10,0,0,0" ToolTip="音量增益模式" Command="{Binding Settings.CycleReplayGainCommand}"/>
      </StackPanel>

      <!-- 第二行：进度 + 音量 -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding Playback.DurationSeconds, Mode=OneWay}"
                Value="{Binding Playback.PositionSeconds, Mode=OneWay}" Width="440"/>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" SmallChange="0.01"
                Value="{Binding Playback.Volume}" Width="120" Margin="12,0,0,0"/>
        <TextBlock Text="{Binding Playback.Volume, StringFormat=P0}" VerticalAlignment="Center" Margin="6,0,0,0"/>
      </StackPanel>
    </Grid>

    <!-- 两栏主体：播放列表 + 正在播放（左侧曲库面板已移除） -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 播放列表 -->
      <GroupBox Header="播放列表" Grid.Column="0" Margin="4">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
            <Button Content="添加文件" Command="{Binding Playlist.AddFilesCommand}"/>
            <Button Content="添加文件夹" Command="{Binding Playlist.AddFolderCommand}" Margin="6,0,0,0"/>
            <Button Content="清空" Command="{Binding Playlist.ClearCommand}" Margin="6,0,0,0"/>
            <Button Content="移除（选中）" Command="{Binding Playlist.RemoveSelectedCommand}" CommandParameter="{Binding ElementName=PlaylistList, Path=SelectedItems}" Margin="6,0,0,0"/>
            <TextBox Text="{Binding Playlist.SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
            <Button Content="保存到云盘" Command="{Binding Playlist.SaveToCloudCommand}" Margin="10,0,0,0"/>
            <Button Content="从云盘加载" Command="{Binding Playlist.LoadFromCloudCommand}" Margin="6,0,0,0"/>
            <TextBlock Text="{Binding Playlist.SyncStatus}" Foreground="#2E7D32" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
          <ListBox x:Name="PlaylistList"
                   ItemsSource="{Binding Playlist.ItemsView}"
                   SelectionMode="Extended"
                   AllowDrop="True"
                   PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown"
                   MouseMove="PlaylistList_MouseMove"
                   Drop="PlaylistList_Drop"
                   MouseDoubleClick="PlaylistList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition>
                        <Condition.Binding>
                          <MultiBinding Converter="{StaticResource IsCurrentItemConverter}">
                            <Binding Path="Item.Track.Id"/>
                            <Binding RelativeSource="{RelativeSource AncestorType=ListBox}" Path="DataContext.Playlist.CurrentItemId"/>
                          </MultiBinding>
                        </Condition.Binding>
                        <Condition.Value>True</Condition.Value>
                      </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#FFF3E0"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Index}" Width="28" Foreground="#888" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Item.Track.Title}" FontWeight="Medium" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Item.Track.Artist, StringFormat=' — {0}'}" Foreground="#5F5E5A" VerticalAlignment="Center"/>
                  <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Padding="4,1" Foreground="White" Background="#9E9E9E" FontSize="11">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="本地"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Item.Track.SourceType}" Value="Cloud">
                            <Setter Property="Text" Value="☁ 云"/>
                            <Setter Property="Background" Value="#1565C0"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="✓已缓存" Foreground="#2E7D32" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCached}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Button Content="下载" Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.Playlist.DownloadCommand}" CommandParameter="{Binding}" Margin="8,0,0,0" Visibility="Collapsed">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Item.Track.SourceType}" Value="Cloud">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="移除（选中）" Click="PlaylistRemove_Click"/>
                <MenuItem Header="播放" Click="PlaylistPlay_Click"/>
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
        </DockPanel>
      </GroupBox>

      <!-- 正在播放 -->
      <GroupBox Header="正在播放" Grid.Column="1" Margin="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- 上半：歌曲信息 + 右上角打赏图 -->
          <Grid Grid.Row="0" Margin="12,12,12,8">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock Text="{Binding Playback.CurrentTitle}" FontSize="22" FontWeight="Medium" TextWrapping="Wrap" MaxWidth="420"/>
              <TextBlock Text="{Binding Playback.CurrentArtist}" FontSize="14" Foreground="#5F5E5A" Margin="0,8,0,0"/>
              <!-- 需求8：把"正在播放 第N首/共M首"放在右侧「正在播放」面板，而非播放列表左下角 -->
              <TextBlock Text="{Binding Playlist.NowPlayingCaption}" FontSize="12" Foreground="#888" Margin="0,14,0,0"/>
              <TextBlock Text="{Binding Playback.LyricsSource}" FontSize="11" Foreground="#9E9E9E" Margin="0,6,0,0"/>
            </StackPanel>
            <Image Source="/Assets/donate_corner.png" Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Stretch="Uniform" Cursor="Hand" ToolTip="给85后财务自由之路赞赏" MouseLeftButtonUp="DonateImage_Click"/>
          </Grid>

          <!-- 中：歌词搜索/手动绑定 -->
          <DockPanel Grid.Row="1" Margin="8,0,8,4">
            <Button DockPanel.Dock="Right" Content="搜索" Width="48" Margin="6,0,0,0"
                    Command="{Binding Playback.SearchLyricsCommand}"/>
            <TextBox Text="{Binding Playback.LyricsSearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="4,2"/>
          </DockPanel>

          <!-- 下半：歌词（点击任意行跳转到该行；当前行高亮） -->
          <ListBox Grid.Row="2" x:Name="LyricsList"
                   ItemsSource="{Binding Playback.LyricsLines}"
                   Margin="8,0,8,8"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="LyricsList_SelectionChanged"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter/>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Foreground="#5F5E5A" Cursor="Hand">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Foreground" Value="#4A8FE7"/>
                          <Setter Property="FontWeight" Value="Bold"/>
                          <Setter Property="FontSize" Value="15"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
