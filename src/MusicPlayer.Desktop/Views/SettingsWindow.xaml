<Window x:Class="MusicPlayer.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:MusicPlayer.Core.Enums"
        Title="设置" Height="470" Width="460" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16">
    <CheckBox Content="尝试 WASAPI 独占输出（失败自动回退默认）" IsChecked="{Binding ExclusiveWasapi}"/>
    <TextBlock Text="下载 / 缓存目录" Margin="0,12,0,4"/>
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseCommand}"/>
      <TextBox Text="{Binding DownloadPath}" IsReadOnly="True" VerticalContentAlignment="Center"/>
    </DockPanel>
    <TextBlock Text="{Binding UsedSpace}" Margin="0,8,0,4"/>
    <Button Content="刷新占用" Command="{Binding RefreshSpaceCommand}" Width="100" HorizontalAlignment="Left"/>
    <TextBlock Text="歌词" Margin="0,12,0,4" FontWeight="Medium"/>
    <TextBlock Text="额外本地歌词目录（音频同目录优先于此处）" Margin="0,4,0,2"/>
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseLyricsCommand}"/>
      <TextBox Text="{Binding LyricsPath}" IsReadOnly="True" VerticalContentAlignment="Center"/>
    </DockPanel>
    <CheckBox Content="无本地/云盘歌词时，允许从网络获取（默认关闭，隐私优先）"
              IsChecked="{Binding OnlineLyricsEnabled}" Margin="0,10,0,0"/>
    <CheckBox Content="云盘歌曲：把歌词上传回云盘同目录（让歌词跟着歌走）"
              IsChecked="{Binding AutoUploadCloudLyrics}" Margin="0,6,0,0"/>
    <TextBlock Text="ReplayGain（响度归一）" Margin="0,12,0,4"/>
    <ComboBox ItemsSource="{Binding ReplayGainModes}" SelectedItem="{Binding ReplayGainMode}" Width="200"/>
    <TextBlock Text="音量" Margin="0,12,0,4"/>
    <Slider Minimum="0" Maximum="1" SmallChange="0.01" Value="{Binding Volume}" Width="320"/>
  </StackPanel>
</Window>
